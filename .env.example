# ---------------------------------------------------------------------------
# Wavelength — environment variables
# Copy to `.env.local` and fill in. Everything here is PUBLIC (NEXT_PUBLIC_*):
# the chat API is called directly from the browser, so there are no secrets.
# ---------------------------------------------------------------------------

# REST base URL — note the `/api` suffix.
NEXT_PUBLIC_API_BASE_URL=https://frontend-task-chatapp.onrender.com/api

# Socket.io origin — the server ROOT, deliberately WITHOUT `/api`.
# Socket.io serves itself at `<origin>/socket.io/`; pointing this at the REST
# base is the single most common way to get a silent connection failure.
NEXT_PUBLIC_SOCKET_URL=https://frontend-task-chatapp.onrender.com

# Canonical site URL, used for metadata/OG tags.
# Leave unset in development — it falls back to http://localhost:$PORT, so it
# follows whichever port `next dev` actually picked. Set it in production to
# the real deployed origin, or every OG tag points at localhost.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
