{
	"name": "wavelength",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.2.2",
	"scripts": {
		"dev": "next dev --turbo",
		"build": "next build",
		"start": "next start",
		"sync": "node .formatter/sync.js",
		"type:check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
		"type:check:tests": "tsc -p tsconfig.test.json --noEmit",
		"type:check:e2e": "tsc -p tsconfig.e2e.json --noEmit",
		"check:all": "pnpm run type:check && pnpm run lint && pnpm run format:check",
		"lint": "eslint src",
		"lint:fix": "eslint --fix src",
		"format:check": "prettier --config .formatter/.prettierrc.js --check \"src/**/*.{js,jsx,ts,tsx,css,scss,json,md}\"",
		"format": "prettier --config .formatter/.prettierrc.js --write \"src/**/*.{js,jsx,ts,tsx,css,scss,json,md}\"",
		"imports:organize": "node .formatter/sync.js --organize-imports",
		"format:all": "pnpm run imports:organize && pnpm run format && pnpm run lint:fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:report": "playwright show-report",
		"test:e2e:install": "playwright install chromium firefox webkit",
		"api:probe": "node scripts/api-probe.mjs"
	},
	"dependencies": {
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-checkbox": "^1.3.11",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@radix-ui/react-visually-hidden": "^1.2.4",
		"@reduxjs/toolkit": "^2.11.2",
		"@tabler/icons-react": "^3.44.0",
		"@tailwindcss/postcss": "^4.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.38.0",
		"libphonenumber-js": "^1.13.11",
		"next": "16.2.6",
		"next-themes": "0.4.6",
		"postcss": "^8.5.14",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"react-redux": "^9.2.0",
		"socket.io-client": "^4.8.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@playwright/test": "^1.60.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "25.9.1",
		"@types/react": "19.2.15",
		"@types/react-dom": "19.2.3",
		"@typescript-eslint/eslint-plugin": "^8.60.0",
		"@typescript-eslint/parser": "^8.60.0",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/coverage-v8": "^4.1.6",
		"autoprefixer": "^10.5.0",
		"eslint": "9.39.4",
		"eslint-config-next": "16.2.6",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-better-tailwindcss": "^4.5.0",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-unicorn": "^64.0.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sass": "^1.99.0",
		"typescript": "6.0.3",
		"vitest": "^4.1.6"
	}
}
